#!/bin/sh /etc/rc.common
START=95
STOP=9
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/libexec/netscope-docker serve
    # No respawn and not enabled at boot. Capture never resumes after a crash.
    procd_set_param term_timeout 15
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
