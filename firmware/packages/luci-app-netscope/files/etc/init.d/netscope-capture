#!/bin/sh /etc/rc.common
# Start the inert supervisor, never a capture. Only authenticated Start creates one.
START=99
STOP=08
USE_PROCD=1
start_service() {
    procd_open_instance capture
    procd_set_param command /usr/libexec/netscope-capture-supervise
    procd_set_param respawn 3600 2 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_set_param limits core="0 0" nofile="128 128"
    procd_set_param term_timeout 30
    procd_close_instance
    procd_open_instance failopen
    procd_set_param command /usr/libexec/netscope-proxy-guard
    procd_set_param respawn 3600 2 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
