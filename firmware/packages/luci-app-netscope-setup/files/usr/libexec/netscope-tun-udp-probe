#!/usr/bin/lua
-- Source-routed STUN probe through the isolated NETSCOPE Mieru TUN.
local n=require'nixio'
local function now() local s,u=n.gettimeofday();return tonumber(s or 0)+(tonumber(u or 0)/1000000) end
local function fail() io.stderr:write('netscope-tun-udp-probe: no valid UDP reply\n');os.exit(1) end
local udp=n.socket('inet','dgram');if not udp then fail() end
udp:setopt('socket','sndtimeo',5);udp:setopt('socket','rcvtimeo',8)
if not udp:bind('198.18.20.1',0) or not udp:connect('stun.cloudflare.com',3478) then fail() end
local cookie=string.char(0x21,0x12,0xa4,0x42);local first,warm,total=0,0,0
for sample=1,3 do
  local tx=string.rep(string.char(0x6b),11)..string.char(sample)
  local request=string.char(0,1,0,0)..cookie..tx;local started=now()
  if not udp:send(request) then fail() end
  local response=udp:recv(2048);local latency=math.max(0,math.floor((now()-started)*1000+0.5))
  if not response or #response<20 or response:sub(1,2)~=string.char(1,1) or response:sub(5,8)~=cookie or response:sub(9,20)~=tx then fail() end
  if sample==1 then first=latency else total=total+latency end
end
udp:close();warm=math.floor(total/2+0.5)
print(string.format('{"udp":true,"target":"public-stun","first_latency_ms":%d,"warm_latency_ms":%d}',first,warm))
